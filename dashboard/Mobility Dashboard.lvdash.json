{
  "datasets": [
    {
      "name": "4ff9588e",
      "displayName": "monthly_summary",
      "queryLines": [
        "SELECT * FROM mobility.gold.monthly_summary"
      ],
      "catalog": "mobility",
      "schema": "gold"
    },
    {
      "name": "eddf2fa0",
      "displayName": "trips_by_zone",
      "queryLines": [
        "SELECT Zone, Borough, total_trips, avg_fare\r\n",
        "FROM mobility.gold.trips_by_zone\r\n",
        "ORDER BY total_trips DESC\r\n",
        "LIMIT 10"
      ]
    },
    {
      "name": "02581522",
      "displayName": "trips_by_hour",
      "queryLines": [
        "SELECT * FROM mobility.gold.trips_by_hour"
      ]
    },
    {
      "name": "5089a06f",
      "displayName": "rejected rows",
      "queryLines": [
        "SELECT reject_reason, COUNT(*) AS rejected_rows\r\n",
        "FROM mobility.silver.trips_quarantine\r\n",
        "GROUP BY reject_reason"
      ]
    }
  ],
